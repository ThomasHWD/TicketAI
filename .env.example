# --- CONFIGURATION POSTGRESQL ---
# Ces identifiants doivent rester alignés avec le DATABASE_URL codé en dur dans
# docker-compose.dev.yml (postgresql://user:test@postgres:5432/ticketai_db).
# Ne pas les laisser vides : le healthcheck postgres les interpole et une valeur
# vide rend la sonde invalide, ce qui bloque le démarrage de toute la stack.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ticketai_db
POSTGRES_USER=user
POSTGRES_PASSWORD=test

# --- CONFIGURATION QDRANT ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --- CONFIGURATION VALKEY ---
VALKEY_HOST=localhost
VALKEY_PORT=6379
