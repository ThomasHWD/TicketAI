POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ticketai_db
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/ticketai

DOCUMENTS_STORAGE_PATH=/data/documents

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

VALKEY_HOST=localhost
VALKEY_PORT=6379

ALBERT_API_KEY=
ALBERT_LLM_URL=https://albert.api.etalab.gouv.fr/v1
ALBERT_LLM_MODEL_NAME=openai/gpt-oss-120b

ALBERT_EMBEDDINGS_URL=https://albert.api.etalab.gouv.fr/v1/embeddings
ALBERT_EMBEDDINGS_MODEL_NAME=BAAI/bge-m3

ALBERT_RERANKER_URL=https://albert.api.etalab.gouv.fr/v1/rerank
ALBERT_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Modèles dédiés aux juges.
# Laisser vide fait retomber sur ALBERT_LLM_MODEL_NAME, ce qui partage le quota
# entre génération RAG et jugement, produisant des silences en charge.
ALBERT_GARDE_MODEL_NAME=gemma-4-31b-it
ALBERT_REVERIF_MODEL_NAME=gemma-4-31b-it

# ── Contextualisation des chunks (Contextual Retrieval) ──────────────
# Chaque chunk est préfixé d'une phrase qui le situe dans son document avant
# d'être indexé : sans elle, « les alternants n'en bénéficient pas » ne contient
# pas le mot « télétravail » et reste introuvable. Coût : 1 appel de synopsis +
# 1 appel par lot de 5 chunks, à l'ingestion seulement.
# Vide fait retomber sur ALBERT_TAG_MODEL_NAME (quota déjà séparé de la génération).
ALBERT_CONTEXTE_MODEL_NAME=
# false restitue exactement le comportement antérieur, sans appel supplémentaire.
CONTEXTUALISATION_ACTIVE=true

SEUIL_CANONIQUE=3
SEUIL_COSINUS=0.80
JOURS_AUTO_CLOTURE=7

# ── Recherche lexicale (BM25) ────────────────────────────────────────
# Porte lexicale : un candidat est examiné si son cosinus franchit le seuil OU
# si son score BM25 par terme franchit celui-ci. 0 ferme la porte lexicale.
# À recalibrer quand le corpus grossit (l'IDF croît en log N).
SEUIL_LEXICAL_PAR_TERME=1.0

# ── FAQ (page /faq, consultation des réponses canoniques) ────────────
# Une recherche = un embedding Albert (quota : 1 000 requêtes/jour/modèle).
# FAQ_RATE_LIMIT_PAR_MINUTE=0 désactive la limite.
FAQ_MAX_RESULTATS=5
FAQ_SEUIL_PERTINENCE=0.75
# Second rang « peut-être cherchiez-vous ceci ? », seulement si rien ne franchit
# le seuil ci-dessus.
FAQ_SEUIL_INCERTAIN=0.55
FAQ_RATE_LIMIT_PAR_MINUTE=20
FAQ_RATE_LIMIT_PAR_JOUR=100
TICKET_RATE_LIMIT_PAR_JOUR=50

# ── Journaux ─────────────────────────────────────────────────────────
# API et workers (le -l de celery est ignoré). DEBUG détaille chaque étape d'une question (scores, rerank).
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────
# Liste JSON des origines autorisées. En dev, laisser les valeurs par défaut (localhost).
# En prod, remplacer par l'URL publique de l'application.
# ALLOWED_ORIGINS=["https://ticketai.mon-entreprise.fr"]

# ── Authentification ──────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Renseigner pour l'authentification LDAP / Active Directory.
# ldaps:// (636) obligatoire : en ldap:// (389), le mot de passe de chaque agent et celui du compte de service
# circulent en clair — le TLS n'est négocié que pour une URL ldaps://.
LDAP_SERVER_URL=ldaps://ad.mon-entreprise.local:636
LDAP_SERVER_URL_SECONDARY=ldaps://ad2.mon-entreprise.local:636
LDAP_BIND_DN=CN=svc-ticketai,OU=Services,DC=mon-entreprise,DC=local
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=OU=Users,DC=mon-entreprise,DC=local
LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_FIRSTNAME=givenName
LDAP_ATTR_LASTNAME=sn
LDAP_ATTR_DEPARTMENT=department
# Nom seul du groupe AD, comparé au CN de chaque memberOf (égalité, insensible à la casse).
# Un DN complet (CN=…,OU=…,DC=…) est aussi accepté. Vides → refus au démarrage.
LDAP_GROUP_ADMIN=TicketAI-Admins
LDAP_GROUP_GESTIONNAIRE=TicketAI-Gestionnaires
LDAP_TLS_VALIDATE=True
LDAP_TIMEOUT=5
