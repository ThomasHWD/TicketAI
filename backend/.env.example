POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ticketai_db
POSTGRES_USER=
POSTGRES_PASSWORD=

DOCUMENTS_STORAGE_PATH=/tmp/ticketai/documents

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

VALKEY_HOST=localhost
VALKEY_PORT=6379

ALBERT_API_KEY=
ALBERT_LLM_URL=https://albert.api.etalab.gouv.fr/v1
ALBERT_LLM_MODEL_NAME=openai/gpt-oss-120b

ALBERT_EMBEDDINGS_URL=https://albert.api.etalab.gouv.fr/v1/embeddings
ALBERT_EMBEDDINGS_MODEL_NAME=BAAI/bge-m3

ALBERT_RERANKER_URL=https://albert.api.etalab.gouv.fr/v1/rerank
ALBERT_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

SEUIL_CANONIQUE=3
# Filtre de coût avant le garde, pas filtre de sûreté : c'est le juge LLM qui décide
# ce qui peut être servi sans revue humaine. Calibré le 07/09/2026 sur 48 cas réels
# (Docs/technique/rapport-test-cache-semantique.md, § 12) : 0,80 sert 19 réponses sans
# revue contre 8 à 0,90, sans un seul faux positif.
# Ne pas descendre plus bas : la bande [0,75 ; 0,80) ne contient que des demandes
# réellement différentes. Aucune valeur par défaut dans le code — cette clé doit être
# renseignée dans chaque environnement.
SEUIL_COSINUS=0.80
# Modèles dédiés aux juges. Les laisser vides fait retomber sur ALBERT_LLM_MODEL_NAME,
# ce qui partage un quota Albert (par *modèle*) entre génération et jugement : les appels
# de génération vident alors le compteur du juge, produisant des silences.
ALBERT_GARDE_MODEL_NAME=gemma-4-31b-it
ALBERT_REVERIF_MODEL_NAME=gemma-4-31b-it
JOURS_AUTO_CLOTURE=7

# ── Authentification ──────────────────────────────────────────────────
# AUTH_MODE=ldap  → vrai serveur LDAP / Active Directory (variables ci-dessous).
# Toute autre valeur → fallback base de données seule (tests, offline).
AUTH_MODE=ldap

# (ex. `openssl rand -hex 32`).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Renseigner uniquement quand AUTH_MODE=ldap (bascule sans changement de code) :
LDAP_SERVER_URL=ldap://ad.mon-entreprise.local:389
LDAP_BIND_DN=CN=svc-ticketai,OU=Services,DC=mon-entreprise,DC=local
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=OU=Users,DC=mon-entreprise,DC=local
LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_FIRSTNAME=givenName
LDAP_ATTR_LASTNAME=sn
LDAP_ATTR_DEPARTMENT=department
LDAP_GROUP_GESTIONNAIRE=CN=TicketAI-Gestionnaires,OU=Groups,DC=mon-entreprise,DC=local
LDAP_GROUP_ADMIN=CN=TicketAI-Admins,OU=Groups,DC=mon-entreprise,DC=local
LDAP_SERVER_URL_SECONDARY=ldap://ad2.mon-entreprise.local:389
LDAP_TLS_VALIDATE=False
LDAP_TIMEOUT=5
